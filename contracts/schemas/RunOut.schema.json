  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Id"
    },
    "lead_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lead Id"
    },
    "kind": {
      "enum": [
        "discovery",
        "recheck_recent",
        "recheck_stale",
        "recheck_lead",
        "reanalyze_lead",
        "reanalyze_all",
        "import",
        "export"
