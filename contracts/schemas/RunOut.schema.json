        "done": {
          "title": "Done",
          "type": "integer"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        }
      },
      "required": [
        "done",
        "total",
        "label"
      ],
      "title": "Progress",
      "type": "object"
    },
    "RunCounts": {
      "additionalProperties": false,
      "properties": {
        "requests": {
          "title": "Requests",
          "type": "integer"
        },
        "details_fetched": {
          "title": "Details Fetched",
          "type": "integer"
        },
        "created": {
          "title": "Created",
          "type": "integer"
        },
        "updated": {
          "title": "Updated",
          "type": "integer"
        },
        "duplicates": {
          "title": "Duplicates",
          "type": "integer"
        },
        "excluded": {
          "title": "Excluded",
          "type": "integer"
        },
        "parse_failures": {
          "title": "Parse Failures",
          "type": "integer"
        },
        "fetch_failures": {
          "title": "Fetch Failures",
          "type": "integer"
        },
        "policy_stops": {
          "title": "Policy Stops",
          "type": "integer"
        },
        "ai_failures": {
          "title": "Ai Failures",
          "type": "integer"
        }
