{
  "$defs": {
    "AISettings": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "external_transfer_consent": {
          "title": "External Transfer Consent",
          "type": "boolean"
        },
        "engine_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Engine Label"
        },
        "monthly_cost_cap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Monthly Cost Cap"
        },
        "daily_cost_cap": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Daily Cost Cap"
        },
        "key_configured": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "API 키 저장 여부. 저장소 상태를 확인하지 못하면 null. 값은 반환하지 않음",
          "title": "Key Configured"
        },
        "provider_available": {
          "title": "Provider Available",
          "type": "boolean"
        },
        "provider": {
          "const": "openai",
          "default": "openai",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "const": "gpt-4.1-mini-2025-04-14",
          "default": "gpt-4.1-mini-2025-04-14",
          "title": "Model",
          "type": "string"
        },
        "usd_to_krw_rate": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usd To Krw Rate"
        },
        "max_output_tokens": {
          "default": 1024,
          "maximum": 4096,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "pricing_confirmed": {
          "default": false,
          "title": "Pricing Confirmed",
          "type": "boolean"
        },
        "price_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "확인한 서버 요금표 버전; 읽기 전용",
          "title": "Price Version"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "database_generation": {
          "default": 0,
          "minimum": 0,
          "title": "Database Generation",
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "external_transfer_consent",
        "engine_label",
        "monthly_cost_cap",
        "daily_cost_cap",
        "key_configured",
        "provider_available"
      ],
      "title": "AISettings",
      "type": "object"
    },
    "NotificationSettings": {
      "additionalProperties": false,
      "properties": {
        "new_recommended": {
          "title": "New Recommended",
          "type": "boolean"
        },
        "new_review": {
          "default": true,
          "title": "New Review",
          "type": "boolean"
        },
        "daangn_messages": {
          "default": true,
          "title": "Daangn Messages",
          "type": "boolean"
        },
        "meaningful_change": {
          "title": "Meaningful Change",
          "type": "boolean"
        },
        "source_issue": {
          "title": "Source Issue",
          "type": "boolean"
        },
        "quiet_hours": {
          "$ref": "#/$defs/QuietHours"
        }
      },
      "required": [
        "new_recommended",
        "meaningful_change",
        "source_issue",
        "quiet_hours"
      ],
      "title": "NotificationSettings",
      "type": "object"
    },
    "ProfileSettings": {
      "additionalProperties": false,
      "properties": {
        "services": {
          "items": {
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        },
        "skills": {
          "title": "Skills",
          "type": "string"
        },
        "excluded_work": {
          "title": "Excluded Work",
          "type": "string"
        },
        "min_contract": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Contract"
        },
        "target_hourly": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Hourly"
        },
        "weekly_hours": {
          "anyOf": [
            {
              "maximum": 168,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Weekly Hours"
        },
        "onsite": {
          "enum": [
            "no",
            "first_meeting",
            "yes"
          ],
          "title": "Onsite",
          "type": "string"
        },
        "allow_short_term_employment": {
          "title": "Allow Short Term Employment",
          "type": "boolean"
        },
        "business_registered": {
          "default": false,
          "title": "Business Registered",
          "type": "boolean"
        },
        "tax_invoice": {
          "default": false,
          "title": "Tax Invoice",
          "type": "boolean"
        }
      },
      "required": [
        "services",
        "skills",
        "excluded_work",
        "min_contract",
        "target_hourly",
        "weekly_hours",
        "onsite",
        "allow_short_term_employment"
      ],
      "title": "ProfileSettings",
      "type": "object"
    },
    "QueryGroup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "enabled",
        "keywords"
      ],
      "title": "QueryGroup",
      "type": "object"
    },
    "QueryGroups": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/QueryGroup"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "version",
        "groups"
      ],
      "title": "QueryGroups",
      "type": "object"
    },
    "QuietHours": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "start": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "start",
        "end"
      ],
      "title": "QuietHours",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile": {
      "$ref": "#/$defs/ProfileSettings"
    },
    "recheck": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "const": "ttl_hours"
      },
      "title": "Recheck",
      "type": "object"
    },
    "notifications": {
      "$ref": "#/$defs/NotificationSettings"
    },
    "ai": {
      "$ref": "#/$defs/AISettings"
    },
    "retention": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "const": "raw_days"
      },
      "title": "Retention",
      "type": "object"
    },
    "query_groups": {
      "$ref": "#/$defs/QueryGroups"
    }
  },
  "required": [
    "profile",
    "recheck",
    "notifications",
    "ai",
    "retention",
    "query_groups"
  ],
  "title": "SettingsOut",
  "type": "object"
}
