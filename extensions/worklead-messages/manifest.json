{
  "manifest_version": 3,
  "name": "Worklead 당근 메시지 연결",
  "description": "직접 선택한 당근알바 탭의 미읽음 표시만 이 PC의 Worklead로 전달합니다.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Worklead 메시지 연결"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"}
}
