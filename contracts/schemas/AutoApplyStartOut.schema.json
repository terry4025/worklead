{
  "$defs": {
    "AutoApplyStatus": {
      "properties": {
        "provider": {
          "default": "chrome",
          "enum": [
            "chrome",
            "managed_edge"
          ],
          "title": "Provider",
          "type": "string"
        },
        "setup_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup Stage"
        },
        "browser_open": {
          "default": false,
          "title": "Browser Open",
          "type": "boolean"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "remembers_connection": {
          "default": false,
          "title": "Remembers Connection",
          "type": "boolean"
        },
        "paired": {
          "default": false,
          "title": "Paired",
          "type": "boolean"
        },
        "state": {
          "default": "stopped",
          "enum": [
            "stopped",
            "waiting",
            "connected",
            "paused"
          ],
          "title": "State",
          "type": "string"
        },
        "min_score": {
          "default": 50,
          "title": "Min Score",
          "type": "integer"
        },
        "daily_limit": {
          "default": 20,
          "title": "Daily Limit",
          "type": "integer"
        },
        "today_submitted": {
          "default": 0,
          "title": "Today Submitted",
          "type": "integer"
        },
        "today_reserved": {
          "default": 0,
          "title": "Today Reserved",
          "type": "integer"
        },
        "held": {
          "default": 0,
          "title": "Held",
          "type": "integer"
        },
        "uncertain": {
          "default": 0,
          "title": "Uncertain",
          "type": "integer"
        },
        "last_connected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Connected At"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "message": {
          "default": "자동 지원이 꺼져 있습니다",
          "title": "Message",
          "type": "string"
        },
        "attempts": {
          "items": {
            "$ref": "#/$defs/AutoAttemptOut"
          },
          "title": "Attempts",
          "type": "array"
        },
        "queue_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Reason"
        },
        "needs_user_action": {
          "default": false,
          "title": "Needs User Action",
          "type": "boolean"
        },
        "retry_waiting": {
          "default": 0,
          "title": "Retry Waiting",
          "type": "integer"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/AutoCandidateOut"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "title": "AutoApplyStatus",
      "type": "object"
    },
    "AutoAttemptOut": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lead_id": {
          "title": "Lead Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "state": {
          "enum": [
            "claimed",
            "ready",
            "submitting",
            "submitted",
            "already_applied",
            "held",
            "uncertain"
          ],
          "title": "State",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "retry_count": {
          "default": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "retry_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After"
        }
      },
      "required": [
        "id",
        "lead_id",
        "title",
        "state",
        "reason_code",
        "created_at",
        "finished_at"
      ],
      "title": "AutoAttemptOut",
      "type": "object"
    },
    "AutoCandidateOut": {
      "properties": {
        "lead_id": {
          "title": "Lead Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "stage": {
          "enum": [
            "queued",
            "source_refresh",
            "rejected",
            "form_review",
            "permit_issued",
            "submitted",
            "already_applied",
            "retry_wait",
            "held",
            "uncertain"
          ],
          "title": "Stage",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "retry_count": {
          "default": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "retry_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "refresh_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh State"
        },
        "refresh_error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refresh Error Code"
        },
        "last_checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Checked At"
        }
      },
      "required": [
        "lead_id",
        "title",
        "stage"
      ],
      "title": "AutoCandidateOut",
      "type": "object"
    },
    "AutoConnection": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        },
        "purpose": {
          "const": "auto_apply",
          "default": "auto_apply",
          "title": "Purpose",
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "url",
        "token"
      ],
      "title": "AutoConnection",
      "type": "object"
    }
  },
  "properties": {
    "connection": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutoConnection"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/AutoApplyStatus"
    },
    "extension_directory": {
      "title": "Extension Directory",
      "type": "string"
    }
  },
  "required": [
    "connection",
    "status",
    "extension_directory"
  ],
  "title": "AutoApplyStartOut",
  "type": "object"
}
