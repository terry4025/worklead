  "required": [
    "id",
    "source_id",
    "lead_id",
    "kind",
    "state",
    "trigger",
    "created_at",
    "started_at",
    "finished_at",
    "progress",
    "counts",
    "error",
    "note",
    "scan_cycle",
    "result"
  ],
  "title": "RunOut",
  "type": "object"
}
