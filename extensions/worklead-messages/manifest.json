{
  "manifest_version": 3,
  "name": "Worklead 당근 연결",
  "description": "선택한 탭의 미읽음 감시와 별도 승인한 50점 이상 공고의 저장된 자기소개 자동 지원을 연결합니다.",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["http://127.0.0.1/*", "https://jobs.daangn.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Worklead 당근 연결"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*"}
}
